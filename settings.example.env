# How summaries reach you:
#   whatsapp  needs the two CallMeBot lines below
#   popup     a free pop-up window on your Mac, with no permissions to set up
#   mac       a free Mac notification (macOS must allow it for your Terminal)
# The full text is always saved to latest-summary.txt in the same folder.
DELIVERY=whatsapp

# WhatsApp through CallMeBot. Your number with country code and no plus sign,
# e.g. 2547XXXXXXXX
CALLMEBOT_PHONE=PASTE_YOUR_NUMBER_HERE
# The key CallMeBot sends you on WhatsApp. Keep it private.
CALLMEBOT_APIKEY=PASTE_API_KEY_HERE

# Suggest cleaning up a sender after this many bulk or spam emails.
CLEANUP_MIN_EMAILS=5
